# Copy to .env to override. Every value below is already the default —
# SYNAPSE runs with no configuration at all.

# Where the graph is stored. Use ":memory:" for a throwaway session.
SYNAPSE_DB_PATH=synapse.db

# Daemon bind address.
SYNAPSE_HOST=127.0.0.1
SYNAPSE_PORT=8000

# Origins allowed to call the daemon (the canvas runs on its own port).
SYNAPSE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Local embedding model for semantic search. Fetched once, then offline.
# Any fastembed-supported model works; keep DIM in step and re-run
# `python -m app.cli.reindex` after changing it.
SYNAPSE_EMBEDDING_MODEL=intfloat/multilingual-e5-large
SYNAPSE_EMBEDDING_DIM=1024

# Where the canvas looks for the daemon.
NEXT_PUBLIC_API_URL=http://localhost:8000
